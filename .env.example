# API 서버 base URL (orval 생성 클라이언트가 사용)
# dev 브라우저 요청은 next.config.ts의 /api/* rewrite 프록시를 경유한다 (개발 API 서버에 CORS 헤더가 없음)
NEXT_PUBLIC_API_URL=https://api-dev.pallang.co.kr

# 카카오 로그인(웹) — REST 앱 키. 서버 Route Handler에서만 사용하며 브라우저에 노출되지 않는다(비 NEXT_PUBLIC_).
KAKAO_REST_API_KEY=
# 카카오 로그인 client_secret 사용 시에만 설정(선택).
KAKAO_CLIENT_SECRET=
