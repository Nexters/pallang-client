# API 서버 base URL (orval 생성 클라이언트가 사용)
# 브라우저 요청은 next.config.ts의 /api/* rewrite 프록시를 경유한다 (API 서버에 CORS 헤더가 없음)
#
# 이 값은 배포 환경마다 다르고, Vercel 환경변수가 단일 소스다. 아래는 로컬 개발용 기본값일 뿐이다.
#   Production (release 브랜치 → www.pallang.co.kr) : https://api.pallang.co.kr
#   Preview    (develop 등     → dev.pallang.co.kr) : https://api-dev.pallang.co.kr
# 웹뷰 앱은 원격 URL을 로드할 뿐이라 API 서버를 직접 고르지 않는다 — 어느 웹을 로드하느냐가 곧 어느 API다.
#
# 주의: rewrites()는 빌드 타임에 라우트 매니페스트로 구워진다. Vercel에서 값만 바꾸고
# 재배포하지 않으면 이미 떠 있는 배포는 계속 옛 API를 부른다.
NEXT_PUBLIC_API_URL=https://api-dev.pallang.co.kr

# Google Analytics 4 측정 ID. 운영 Vercel 환경(VERCEL_ENV=production)에서만 사용된다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 카카오 로그인(웹) — REST 앱 키. 서버 Route Handler에서만 사용하며 브라우저에 노출되지 않는다(비 NEXT_PUBLIC_).
KAKAO_REST_API_KEY=
# 카카오 로그인 client_secret 사용 시에만 설정(선택).
KAKAO_CLIENT_SECRET=
