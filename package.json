{
  "name": "pallang-client",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bash scripts/ensure-env.sh && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "api:gen": "orval",
    "test:watch": "vitest",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cap:sync": "cap sync",
    "cap:ios": "cap run ios",
    "cap:android": "cap run android",
    "cap:open:ios": "cap open ios",
    "cap:dev:ios": "bash scripts/cap-dev.sh ios",
    "cap:dev:android": "bash scripts/cap-dev.sh android-emulator",
    "cap:dev:sync": "bash scripts/cap-dev.sh sync-only",
    "ios:archive": "bash scripts/ios-archive.sh",
    "ios:archive:dev": "CAP_SERVER_URL=https://dev.pallang.co.kr bash scripts/ios-archive.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@tanstack/react-query": "^5.101.4",
    "capacitor-kakao-login": "link:./native-plugins/kakao-login",
    "clsx": "^2.1.1",
    "galmuri": "^2.40.3",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-barrel-files": "^1.3.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.5.3",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "next-devtools-mcp": "^0.4.0",
    "orval": "^8.23.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
