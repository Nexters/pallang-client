<?xml version="1.0" encoding="utf-8"?>
<!-- 스플래시(콜드 스타트 windowBackground + Capacitor SplashScreen ImageView 공용).
     통짜 비트맵을 화면에 맞춰 늘리던 방식(#345의 "두둑" 원인)을 웹 스플래시 CSS와 같은 구성으로 분해한다:
     ① 24dp 격자 타일 반복 ② 하단으로 갈수록 neutral-200으로 가라앉는 그라디언트
     ③ 로고+태그라인 블록은 240×125dp 고정 중앙 — 기기 크기와 무관하게 웹 스플래시의 로고와 같은 크기. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/splash_grid"
            android:tileMode="repeat" />
    </item>
    <!-- 웹은 화면 하단 80.7% 영역에 transparent→#e5e5e5 그라디언트를 깐다. drawable에는 % 오프셋이
         없어 시작점을 대표 기기(높이 ~800dp) 기준 154dp로 근사한다 — 매우 완만한 그라디언트라
         기기별 ±20dp 오차는 식별되지 않는다. -->
    <item android:top="154dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00e5e5e5"
                android:endColor="#ffe5e5e5" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="125dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
